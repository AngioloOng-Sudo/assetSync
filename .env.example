USE_MOCK_APIS=true
USE_MOCK_FIXTURE_REPLAY=false
MOCK_KASEYA_FIXTURE_PATH=
MOCK_REVNUE_FIXTURE_PATH=
AUTOSYNC_ENABLED=false
AUTOSYNC_INTERVAL_SECONDS=15
AUTOSYNC_MAX_INTERVAL_SECONDS=300
AUTOSYNC_CRON_WINDOWS=
EVENT_DEDUP_WINDOW_SECONDS=600
WEBHOOK_SHARED_SECRET=
DASHBOARD_PASSWORD=
