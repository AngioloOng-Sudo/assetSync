CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=120
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_PER_SECOND=5
KASEYA_BASE_URL=https://kaseya.example/api/v3
KASEYA_API_TOKEN=
KASEYA_TOKEN_ID=your-kaseya-token-id
