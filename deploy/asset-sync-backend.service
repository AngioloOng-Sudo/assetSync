[Unit]
Description=GSIS Asset Sync Backend API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/gsis-asset-sync
EnvironmentFile=/opt/gsis-asset-sync/.env
ExecStart=/usr/bin/python3 -m uvicorn backend.asset_dashboard:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

